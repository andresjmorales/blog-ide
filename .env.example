# Supabase (required for auth + cloud sync). The Docker image reads these at
# container start; a Node build inlines the two NEXT_PUBLIC_ ones.
# Using the self-hosted stack below instead? Leave these three as they are:
# compose.supabase.yaml sets them from the stack's own keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# --- Self-hosted Supabase (Docker, no Supabase account) ---------------------
# See README → "Run everything yourself". Uncomment COMPOSE_FILE so plain
# `docker compose` commands start the database, auth, storage and gateway
# alongside the app.
# COMPOSE_FILE=compose.yaml:compose.supabase.yaml
#
# Where people open BlogIDE, and where the browser reaches the Supabase
# gateway. Locally, *.localhost needs no DNS. On a server, use your domain
# and a subdomain for the gateway behind your reverse proxy, then set
# NEXT_PUBLIC_SITE_URL to the same value as APP_URL.
# APP_URL=http://localhost:3000
# SUPABASE_PUBLIC_URL=http://supabase.localhost:8000
# SUPABASE_HOST_ALIAS=supabase.localhost
# On a server, publish the gateway only to your reverse proxy:
# SUPABASE_GATEWAY_BIND=127.0.0.1:8000
#
# Paste the output of `sh docker/supabase/generate-secrets.sh` here:
# POSTGRES_PASSWORD=
# JWT_SECRET=
# ANON_KEY=
# SERVICE_ROLE_KEY=
# S3_PROTOCOL_ACCESS_KEY_ID=
# S3_PROTOCOL_ACCESS_KEY_SECRET=
# PG_META_CRYPTO_KEY=
#
# Password-reset email (Resend SMTP shown; any SMTP server works).
# Locally, `--profile mail` runs Mailpit: AUTH_SMTP_HOST=mail.
# AUTH_SMTP_HOST=smtp.resend.com
# AUTH_SMTP_PORT=465
# AUTH_SMTP_USER=resend
# AUTH_SMTP_PASS=re_...
# AUTH_SMTP_ADMIN_EMAIL=noreply@your-domain.example

# Shared hosted-instance flags (skip for normal self-host).
# See docs/HOSTED_OPERATOR.md
# NEXT_PUBLIC_HOSTED=true
# NEXT_PUBLIC_SITE_URL=https://your-host.example
#
# Optional: gate signup behind a code (shows the code field + enforces it on
# the API). Off unless set to true, on hosted and self-host alike.
# NEXT_PUBLIC_ vars are baked in at build time, so redeploy after changing.
# (Docker: all but the Supabase pair; rebuild with `docker compose up -d --build`.)
# NEXT_PUBLIC_BETA_ONLY=true
#
# Optional Stripe storage-tier wiring (hosted only):
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID_PRO=
# STRIPE_WEBHOOK_SECRET=

# Optional Pandoc binary for Word .docx export / .docx+.odt import,
# and for PDF when a PDF engine is installed.
# Unset on typical Vercel deploys; preset in the Docker image. Node self-host example:
# PANDOC_PATH=/usr/bin/pandoc
# PANDOC_PDF_ENGINE=xelatex

# Optional dedicated key for the account secrets vault (Pushbullet / ntfy).
# If unset, SUPABASE_SERVICE_ROLE_KEY is hashed as the encryption key.
# SECRETS_ENCRYPTION_KEY=

# Optional: BlogIDE emails essay share invites itself through Resend.
# Without both, "Email invite" opens the sender's own mail app instead.
# BLOGIDE_EMAIL_FROM must use a domain verified in that Resend account.
# RESEND_API_KEY=re_...
# BLOGIDE_EMAIL_FROM="BlogIDE <drafts@your-domain.example>"

# Moving from Supabase Cloud (self-hosted stack only; see README → "Moving
# from Supabase Cloud"). Remove these once the import is done.
# SOURCE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# SOURCE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SOURCE_SERVICE_ROLE_KEY=
