# Supabase (required for auth + cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Shared hosted-instance flags (skip for normal self-host).
# See docs/HOSTED_OPERATOR.md
# NEXT_PUBLIC_HOSTED=true
# NEXT_PUBLIC_SITE_URL=https://your-host.example
#
# Invite-only signup (show beta code field + enforce on API).
# Set true on blogide.com together with HOSTED for redundancy — NEXT_PUBLIC_
# vars are baked in at build time, so redeploy after changing them.
# Self-host: leave unset (open signup, no beta code).
# NEXT_PUBLIC_BETA_ONLY=true
#
# Optional Stripe storage-tier wiring (hosted only):
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID_PRO=
# STRIPE_WEBHOOK_SECRET=

# Optional Pandoc binary for Word .docx export / .docx+.odt import,
# and for PDF when a PDF engine is installed.
# Unset on typical Vercel deploys; preset in the Docker image. Node self-host example:
# PANDOC_PATH=/usr/bin/pandoc
# PANDOC_PDF_ENGINE=xelatex

# Optional dedicated key for the account secrets vault (Pushbullet / ntfy).
# If unset, SUPABASE_SERVICE_ROLE_KEY is hashed as the encryption key.
# SECRETS_ENCRYPTION_KEY=

# Optional: BlogIDE emails essay share invites itself through Resend.
# Without both, "Email invite" opens the sender's own mail app instead.
# BLOGIDE_EMAIL_FROM must use a domain verified in that Resend account.
# RESEND_API_KEY=re_...
# BLOGIDE_EMAIL_FROM="BlogIDE <drafts@your-domain.example>"
