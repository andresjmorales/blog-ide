# Supabase (required for auth + cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Shared hosted-instance flags and optional Stripe storage-tier wiring:
# see docs/HOSTED_OPERATOR.md (skip for normal self-host).
# NEXT_PUBLIC_HOSTED=true
# NEXT_PUBLIC_SITE_URL=https://your-host.example
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID_PRO=
# STRIPE_WEBHOOK_SECRET=
